# InsForge (from `npx -y @insforge/cli create/link`)
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Full-access admin key: server-only. Used for writes to personal tables after auth + quota checks.
INSFORGE_API_KEY=
# OpenRouter via InsForge AI gateway (`npx -y @insforge/cli ai setup`): server-only
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-haiku-5.5
SMART_MODEL=anthropic/claude-sonnet-5.5
# 32 random bytes, base64. BACK THIS UP: losing it makes stored profiles unreadable.
PROFILE_DATA_KEY=
# Shared secret for cron routes (sent as Authorization: Bearer <secret>)
CRON_SECRET=
# Hunter.io email finder (Pro cold emails). Free tier: 25 searches/month.
HUNTER_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gmail send-on-approval (Google Cloud OAuth client, scope gmail.send). Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram daily picks (@BotFather). The webhook secret is any random string; set it with setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_PRICE_EUR_MONTH=

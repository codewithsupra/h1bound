# Supabase (Project Settings -> API). The service role key bypasses row-level security: server-only, never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts/db-migrate.mts: Connect -> "Session pooler" connection string (works over IPv4). Server-only.
SUPABASE_DB_URL=
# Database size the free plan allows (MB); the health check warns at 80%. Raise it on a paid plan.
DB_LIMIT_MB=500
# OpenRouter (https://openrouter.ai/settings/keys): server-only. Set a spending limit you are comfortable with.
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-haiku-5.5
SMART_MODEL=anthropic/claude-sonnet-5.5
# 32 random bytes, base64. BACK THIS UP: losing it makes stored profiles unreadable.
PROFILE_DATA_KEY=
# Shared secret for cron routes (sent as Authorization: Bearer <secret>)
CRON_SECRET=
# Hunter.io email finder (Pro cold emails). Free tier: 25 searches/month.
HUNTER_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gmail send-on-approval (Google Cloud OAuth client, scope gmail.send). Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram daily picks (@BotFather). The webhook secret is any random string; set it with setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Leave unset until a direct Stripe checkout exists: while off, the UI says "Paid plans open soon".
NEXT_PUBLIC_PAYMENTS_LIVE=
NEXT_PUBLIC_PRICE_EUR_MONTH=

# Operational alerts: the daily health check emails this address only when something is wrong.
OWNER_EMAIL=

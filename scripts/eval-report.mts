/**
 * Runs the fixed matching evaluations and writes docs/EVAL.md. Offline: it reads only the labeled
 * fixtures in tests/eval/ and runs the production matching code against them.
 * Usage: npx tsx scripts/eval-report.mts [--check]   (--check exits 1 if the report on disk is stale)
 */
import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { describe, pct, wilson } from "../lib/eval/metrics";
import { runSponsorRecordEval, type SponsorRecordCases, type Failure } from "../lib/eval/sponsor-record";
import { runVacancyEval, type VacancyCases } from "../lib/eval/vacancy";

const read = <T,>(f: string) => JSON.parse(readFileSync(new URL(`../tests/eval/${f}`, import.meta.url), "utf8")) as T;
const sponsor = read<SponsorRecordCases>("sponsor-record.cases.json");
const vacancy = read<VacancyCases>("vacancy-sponsorship.cases.json");
const holdout = read<VacancyCases>("vacancy-sponsorship.holdout.json");

const rec = await runSponsorRecordEval(sponsor);
const vac = runVacancyEval(vacancy);
const hold = runVacancyEval(holdout);

const rate = (num: number, den: number) => (den ? `${pct(num / den)} (${num}/${den}${wilson(num, den) ? `, 95% CI ${pct(wilson(num, den)![0])}–${pct(wilson(num, den)![1])}` : ""})` : "n/a");
const row = (name: string, c: { tp: number; fp: number; fn: number; tn: number }, p: number | null, r: number | null) =>
  `| ${name} | ${rate(c.tp, c.tp + c.fp)} | ${rate(c.tp, c.tp + c.fn)} | ${c.tp} | ${c.fp} | ${c.fn} | ${c.tn} |`;
const fails = (f: Failure[], max = 40) => (f.length ? f.slice(0, max).map((x) => `- \`${x.id}\` **${x.kind.replace("_", " ")}**: ${x.summary}\n  - ${x.evidence}`).join("\n") + (f.length > max ? `\n- …and ${f.length - max} more` : "") : "_None._");

const b = rec.brand, n = rec.name;
const bc = (c: { tp: number; fp: number; fn: number; tn: number }) => c.tp + c.fp + c.fn + c.tn;
const nName = (st: "linked" | "unlinked") => sponsor.name.filter((c) => c.stratum === st && !c.unsure);

// Population estimate for name linking. Linked employers were linked correctly at the board-brand precision
// measured on the random sample; unlinked employers are missed at the rate seen in the random unlinked sample.
const pop = sponsor.population;
const rand = b.bySet.random.confusion;
const pLink = rand.tp / Math.max(1, rand.tp + rand.fp);
const unl = nName("unlinked");
const missed = unl.filter((c) => c.expect !== null).length;
const miss = missed / Math.max(1, unl.length);
const missCi = wilson(missed, unl.length) ?? [miss, miss];
const estRecall = (m: number) => (pop.linkedEmployers * pLink) / (pop.linkedEmployers * pLink + pop.unlinkedEmployers * m);
const estMissEmployers = (m: number) => Math.round(pop.unlinkedEmployers * m);

const md = `# Matching evaluation

Generated by \`scripts/eval-report.mts\` from the labeled sets in \`tests/eval/\`. Regenerate with \`npx tsx scripts/eval-report.mts\`; \`npm test\` fails if a metric drops below the floor recorded in \`tests/eval.test.ts\`.

**Labels are by an AI labeler (${sponsor.labeler}) and have not been independently verified.** Cases marked \`unsure\`/\`unclear\` are excluded from the metrics and counted. Samples are small, so rates show a 95% Wilson interval: read the interval, not the point estimate. Drawn ${sponsor.drawnAt} from the live data; the sets are frozen, so a change in the matcher moves the numbers and a change in the data does not.

Two different questions are measured, and kept apart on purpose:

1. **Sponsor-record matching**: is this employer the same organisation as an entry on the official register (UK Home Office, Dutch IND, Irish permits)?
2. **Vacancy sponsorship**: does this posting itself say it offers or rules out visa sponsorship? An employer on the register can post a role that says "no sponsorship", and the reverse.

## 1. Sponsor-record matching

Population when drawn: ${pop.linkedEmployers} employers (${pop.linkedJobs} active jobs) linked to a register entry, ${pop.unlinkedEmployers} employers (${pop.unlinkedJobs} jobs) not linked.

### 1a. Board brand to register entry (\`brandMatches\`)

A job board's company name is attached to a register entry, and every job on that board inherits the entry. **Positive = the pipeline accepts the pair; correct = the entry is the same organisation.** Precision is the share of accepted links that are the right organisation, and it is what backs the "Licensed sponsor" badge.

| Set | Precision | Recall | TP | FP | FN | TN |
|---|---|---|---|---|---|---|
${row(`Random sample of linked employers (${bc(rand)} pairs)`, rand, null, null)}
${row(`Stress set: brand collisions, enriched on purpose (${bc(b.bySet.stress.confusion)} pairs)`, b.bySet.stress.confusion, null, null)}

- The **random sample** is the honest estimate of how often a board link is right across all linked employers: ${describe("correct", rand.tp, rand.tp + rand.fp)}.
- The **stress set** is drawn from the boards whose brand is a prefix of several register entries (441 of 882 board links were prefix-only when drawn; 137 of those have rivals). Its precision is deliberately pessimistic and is not a population rate. It shows what kind of company the rule lets through.
- Recall is 100% because the rule accepts every prefix; the cost is the false positives below.
- Excluded as unsure: ${b.excludedUnsure}.

#### Confirmed-sponsor claim (what the badge says)

A link is **confirmed** only when it is exact, or unique (no other register entry shares the brand). Links with look-alike entries are kept but shown as "Possible sponsor: check which entity hires you" (\`linkMatch\` in \`lib/ingest/boards.ts\`). **Positive = confirmed; correct = same organisation.**

| Set | Precision | Recall | TP | FP | FN | TN |
|---|---|---|---|---|---|---|
${row(`Random sample (${bc(b.confirmed.bySet.random.confusion)} pairs)`, b.confirmed.bySet.random.confusion, null, null)}
${row(`Stress set (${bc(b.confirmed.bySet.stress.confusion)} pairs)`, b.confirmed.bySet.stress.confusion, null, null)}

- **Before** (any prefix accepted): random 98.5% (67/68), stress 75% (79/105).
- **After**: no wrong organisation is confirmed in either set. The cost is demotion: of the ${b.confirmed.ambiguous.same + b.confirmed.ambiguous.different} pairs that become "possible", ${b.confirmed.ambiguous.same} really are the same organisation (mostly sister entities of one group such as NTS, Stripe, WPP) and ${b.confirmed.ambiguous.different} are different companies. On the random sample only ${b.confirmed.bySet.random.confusion.fn} of ${b.confirmed.bySet.random.confusion.tp + b.confirmed.bySet.random.confusion.fn} correct links lose "confirmed"; in the stress set, recall of confirmed claims is low by construction.
- **Production impact** (dry run of \`scripts/classify-board-links.mts\` on 2026-11-01): 882 board links = 595 exact, 150 unique, 137 ambiguous. Active jobs behind them: 5,277 exact, 1,143 unique, 1,094 ambiguous. About 1,094 jobs (15% of board-linked jobs) would show "Possible sponsor" instead of "Licensed sponsor".
- The name-matching path (1b) is unchanged and always exact.

**Failure cases of the old rule, now demoted to "possible" (${b.failures.length}):**

${fails(b.failures)}

**Confirmed-claim failures after the change (${b.confirmed.failures.length}):**

${fails(b.confirmed.failures)}

### 1b. Employer name to register entry (\`licenceFor\`, name path)

A job's employer name is linked to a register entry when their normalised keys are equal. **Positive = a link was made.** A link to the wrong entry counts against both precision and recall.

- **Employers already linked by name** (${nName("linked").length} drawn): ${nName("linked").filter((c) => !n.failures.some((f) => f.id === c.id)).length}/${nName("linked").length} linked to the correct entry.
- **Employers with no link** (${unl.length} labeled, drawn at random): ${unl.length - missed} are correctly unlinked (not on the register), ${missed} are on the register and missed. These were chosen *because* they are unlinked, so the matcher links none of them by construction; the miss rate below is the informative number, not a recall figure.

Of the ${unl.length} labeled unlinked employers, ${missed} are on the register under a name the exact-key rule cannot match (brand versus legal name: "Sumo Logic" vs "Sumologic Limited", "Elastic" vs "elasticsearch B.V."). That is ${describe("the miss rate among unlinked employers", missed, unl.length)}.

**Population estimate (unlinked employers missed by name linking, weighted to the real counts):** about ${estMissEmployers(miss)} of the ${pop.unlinkedEmployers} unlinked employers (range ${estMissEmployers(missCi[0])}–${estMissEmployers(missCi[1])}) are on the register. Taking the linked employers as correct at the random-sample precision, employer-level recall is roughly **${pct(estRecall(miss))}** (range ${pct(estRecall(missCi[1]))}–${pct(estRecall(missCi[0]))}). Unlinked employers have fewer jobs each (${(pop.unlinkedJobs / pop.unlinkedEmployers).toFixed(1)} vs ${(pop.linkedJobs / pop.linkedEmployers).toFixed(1)}), so job-level recall is higher than employer-level.

**Failure cases (${n.failures.length}):**

${fails(n.failures)}

## 2. Vacancy sponsorship (\`jdSponsorship\`)

Labels: \`yes\` = the posting says it sponsors or supports visas, \`no\` = it says it does not (or that you must already have the right to work without sponsorship), \`none\` = it says nothing about sponsorship. \`unclear\` cases (conditional or merely implied wording, e.g. "case by case", plain "must have the right to work") are excluded and counted. Duplicated boilerplate (one employer, many jobs, same sentence) is counted once. The mix is enriched for postings that mention visas and for the hard ones the matcher used to miss, so these are not population rates.

Two sets, because the matcher was changed after the first one was scored:

- **Tuned set** (${vacancy.cases.length} cases): used to find and fix bugs (curly apostrophes, "not currently able to sponsor", negated sentences read as offers). Its scores are optimistic by construction.
- **Held-out set** (${holdout.cases.length} cases): drawn after the fix, from different postings, labeled before the matcher was run on it, and **never used for tuning**. This is the number to quote. If it is ever used to tune, draw a new one (\`scripts/eval-draw-jd.mts --holdout\` documents how the draws are ordered).

| Set / class | Precision | Recall | TP | FP | FN | TN |
|---|---|---|---|---|---|---|
${row('Held-out, "yes" (offers sponsorship)', hold.perClass.yes.confusion, hold.perClass.yes.precision, hold.perClass.yes.recall)}
${row('Held-out, "no" (rules it out)', hold.perClass.no.confusion, hold.perClass.no.precision, hold.perClass.no.recall)}
${row('Tuned, "yes" (offers sponsorship)', vac.perClass.yes.confusion, vac.perClass.yes.precision, vac.perClass.yes.recall)}
${row('Tuned, "no" (rules it out)', vac.perClass.no.confusion, vac.perClass.no.precision, vac.perClass.no.recall)}

${describe("Held-out: when a posting states a position, the matcher gets it right", hold.accuracyWhenStated.correct, hold.accuracyWhenStated.total)}. ${describe("Tuned set", vac.accuracyWhenStated.correct, vac.accuracyWhenStated.total)}. Excluded as unclear: ${hold.excludedUnclear} held-out, ${vac.excludedUnclear} tuned.

**Before the fix** (same tuned set, matcher as of the previous commit): "yes" precision 63% (5/8), recall 45% (5/11); "no" precision 100%, recall 65% (20/31). The three false "yes" answers were postings saying "We can't offer visa sponsorship" (curly apostrophe) or "We are not currently able to sponsor visas": a student would have been told the role sponsors when it does not.

**Held-out failure cases (${hold.failures.length}), all misses; none is a wrong answer:**

${fails(hold.failures)}

**Tuned-set failure cases (${vac.failures.length}):**

${fails(vac.failures)}
`;

const out = new URL("../docs/EVAL.md", import.meta.url);
if (process.argv.includes("--check")) {
  if (!existsSync(out) || readFileSync(out, "utf8") !== md) { console.error("docs/EVAL.md is stale: run npx tsx scripts/eval-report.mts"); process.exit(1); }
} else {
  writeFileSync(out, md);
  console.log(md.split("\n").filter((l) => l.startsWith("|") && !l.startsWith("|---") && !l.startsWith("| Set") && !l.startsWith("| Class")).join("\n"));
}
